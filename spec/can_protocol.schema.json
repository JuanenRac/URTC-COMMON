{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/JuanenRac/URTC-COMMON/spec/can_protocol.schema.json",
  "title": "URTC CAN protocol specification (format 1)",
  "description": "The shape of spec/can_protocol.json. A change that is not additive (a renamed key, a changed meaning) raises the format number.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "protocol_version", "title", "about", "byte_order", "clients", "groups", "tools", "enums", "constants", "magic_payloads", "registers", "procedures", "slcan", "messages"],
  "properties": {
    "format": {"const": 1},
    "protocol_version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "about": {"type": "string", "minLength": 1},
    "byte_order": {"const": "big"},
    "clients": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "repository"],
        "properties": {
          "key": {"enum": ["firmware", "flasher", "tester", "web_studio"]},
          "title": {"type": "string"},
          "repository": {"type": "string"}
        }
      }
    },
    "groups": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "title"],
        "properties": {
          "id": {"type": "integer", "minimum": 0, "maximum": 255},
          "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "title": {"type": "string"}
        }
      }
    },
    "enums": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "prefix", "kind", "values"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "title": {"type": "string"},
          "prefix": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*_$"},
          "kind": {"enum": ["value", "flags"]},
          "values": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "name", "title"],
              "properties": {
                "value": {"type": "integer", "minimum": 0, "maximum": 255},
                "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
                "title": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "constants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "title", "group"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "value": {"type": "number", "minimum": 0},
          "title": {"type": "string"},
          "group": {"enum": ["protocol", "timing"]},
          "unit": {"type": "string"},
          "source": {"type": "string"}
        }
      }
    },
    "magic_payloads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "id", "data", "title"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "id": {"$ref": "#/definitions/id"},
          "data": {"type": "string", "pattern": "^([0-9A-F]{2}){4}$"},
          "also_on": {"type": "array", "items": {"$ref": "#/definitions/id"}},
          "title": {"type": "string"}
        }
      }
    },
    "registers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "entries"],
        "properties": {
          "title": {"type": "string"},
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "access", "length", "title"],
              "properties": {
                "id": {"type": "integer", "minimum": 0, "maximum": 255},
                "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
                "access": {"enum": ["read", "write", "write+read", "read/write"]},
                "length": {"type": ["integer", "string"]},
                "title": {"type": "string"},
                "can": {"$ref": "#/definitions/id"},
                "magic": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "procedures": {"type": "object"},
    "slcan": {
      "type": "object",
      "required": ["title", "terminator", "frame", "frames_accepted", "frames_discarded", "hex_digits", "rules", "commands", "bitrate_codes", "bitrate_default_code", "rx_buffer_limit"],
      "properties": {
        "bitrate_codes": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}}},
        "bitrate_default_code": {"type": "string"},
        "rx_buffer_limit": {"type": "integer", "minimum": 64},
        "rules": {"type": "array", "items": {"type": "string"}}
      }
    },
    "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/message"}},
    "multinode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "title", "about", "node_address", "constants", "state_flags", "select_actions", "frames"],
      "properties": {
        "status": {"enum": ["designed_not_implemented_in_firmware"]},
        "title": {"type": "string"},
        "about": {"type": "string"},
        "node_address": {"type": "object", "required": ["bits", "mask", "source"]},
        "constants": {"type": "array", "items": {"type": "object", "required": ["name", "value", "title"]}},
        "state_flags": {"type": "array", "items": {"type": "object", "required": ["name", "bit", "title"]}},
        "select_actions": {"type": "array", "items": {"type": "object", "required": ["value", "name", "title"]}},
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "title", "direction", "span", "layout"],
            "properties": {
              "id": {"type": "string", "pattern": "^0x[0-9A-F]{3}$"},
              "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
              "title": {"type": "string"},
              "direction": {"enum": ["host_to_node", "node_to_host"]},
              "span": {"enum": [1, 32]},
              "layout": {"$ref": "#/definitions/layout"},
              "notes": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  },
  "definitions": {
    "id": {"type": "string", "pattern": "^0x[0-7][0-9A-F]{2}$"},
    "dlc": {
      "type": "object",
      "oneOf": [
        {"additionalProperties": false, "required": ["exact"], "properties": {"exact": {"type": "integer", "minimum": 0, "maximum": 8}}},
        {"additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "integer", "minimum": 0, "maximum": 8}, "max": {"type": "integer", "minimum": 0, "maximum": 8}}},
        {"additionalProperties": false, "required": ["one_of"], "properties": {"one_of": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 8}}}},
        {"additionalProperties": false, "required": ["any"], "properties": {"any": {"const": true}}}
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "offset"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"enum": ["u8", "u16", "u24", "u32", "i16", "i32", "bytes"]},
        "offset": {"type": "integer", "minimum": 0, "maximum": 7},
        "width": {"type": "integer", "minimum": 1, "maximum": 8},
        "title": {"type": "string"},
        "enum": {"type": "string"},
        "strict_enum": {"const": true},
        "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
        "unit": {"type": "string"},
        "fixed": {"type": "string", "pattern": "^([0-9A-F]{2})+$"},
        "optional": {"const": true},
        "present_from_dlc": {"type": "integer", "minimum": 1, "maximum": 8},
        "length": {"type": "integer", "minimum": 1, "maximum": 8},
        "rest": {"const": true},
        "derived_length_of": {"type": "string"},
        "note": {"type": "string"}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "dlc", "fields"],
      "properties": {
        "role": {"enum": ["request", "response"]},
        "variant": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "dlc": {"$ref": "#/definitions/dlc"},
        "fields": {"type": "array", "items": {"$ref": "#/definitions/field"}},
        "frames": {"type": "integer", "minimum": 2, "maximum": 8},
        "note": {"type": "string"},
        "examples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "fields"],
            "properties": {
              "name": {"type": "string"},
              "fields": {"type": "object"},
              "data": {"type": "string", "pattern": "^([0-9A-F]{2})*$"}
            }
          }
        },
        "decode_cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "data"],
            "properties": {"name": {"type": "string"}, "data": {"type": "string", "pattern": "^([0-9A-F]{2})*$"}}
          }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "group", "title", "direction", "handled_by", "tools", "layouts", "implemented_by"],
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "name": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "group": {"type": "string"},
        "title": {"type": "string", "minLength": 1},
        "direction": {"enum": ["host_to_board", "board_to_host", "both"]},
        "handled_by": {"enum": ["application", "bootloader", "both"]},
        "tools": {"oneOf": [{"const": "any"}, {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 24}}]},
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blocked_by_critical_error": {"type": "boolean"},
            "blocked_during_boot_sequence": {"const": true},
            "needs_magic": {"type": "string"}
          }
        },
        "answers": {"$ref": "#/definitions/id"},
        "answered_by": {"type": "array", "items": {"$ref": "#/definitions/id"}},
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"period_ms": {"type": "integer", "minimum": 1}, "watchdog_ms": {"type": "integer", "minimum": 1}}
        },
        "firmware_accepts_dlc": {"$ref": "#/definitions/dlc"},
        "documented_in_prose": {"const": false},
        "read_only": {"type": "boolean"},
        "layouts": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/layout"}},
        "notes": {"type": "array", "items": {"type": "string"}},
        "implemented_by": {
          "type": "object",
          "additionalProperties": false,
          "required": ["firmware", "flasher", "tester", "web_studio"],
          "properties": {
            "firmware": {"type": "boolean"},
            "flasher": {"type": "boolean"},
            "tester": {"type": "boolean"},
            "web_studio": {"type": "boolean"}
          }
        },
        "client_names": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "firmware": {"type": "string"},
            "flasher": {"type": "string"},
            "tester": {"type": "string"},
            "web_studio": {"type": "string"}
          }
        }
      }
    }
  }
}
