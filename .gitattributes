# Auto detect text files and perform LF normalization
* text=auto
# Shell scripts keep LF, Windows batch files keep CRLF on every platform.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Generated and compared byte for byte: they keep LF endings on every platform.
spec/*.json text eol=lf
conformance/*.json text eol=lf
generated/* text eol=lf
src/urtc_common/protocol.py text eol=lf
docs/PROTOCOL_TABLE.md text eol=lf
docs/COMPATIBILITY.md text eol=lf
docs/TOOLS_TABLE.md text eol=lf
docs/STATUS.md text eol=lf
src/urtc_common/tools_catalog.py text eol=lf
src/urtc_common/tool_panels.py text eol=lf
src/urtc_common/firmware_names.py text eol=lf
conformance/fuzz_corpus.txt text eol=lf

# Two pull requests that add an entry to the CHANGELOG at the same place do not conflict: git keeps both entries when it merges or rebases.
CHANGELOG.md merge=union
CHANGELOG_*.md merge=union
CHANGELOG.*.md merge=union
